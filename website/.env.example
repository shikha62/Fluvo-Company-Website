# =============================================================================
# FLUVO PUBLIC WEBSITE ENVIRONMENT VARIABLES
# Set these in your Vercel Project Settings (fluvo.in)
# =============================================================================

# Supabase Public Anon Key (for any client-side public features if needed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-publishable-key

# Supabase Server-Only Key (used exclusively by /api/submit-query serverless function)
# Under RLS, this role bypasses row-level security to securely insert new inquiries.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-secret-key

# SMTP Email Notification Settings (Titan / Hostinger / SendGrid / Amazon SES)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USER=hello@fluvo.in
SMTP_PASSWORD=your-email-account-password
ADMIN_NOTIFICATION_EMAIL=owner@fluvo.in

# Site URLs
PUBLIC_SITE_URL=https://fluvo.in
ADMIN_SITE_URL=https://admin.fluvo.in
