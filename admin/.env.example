# =============================================================================
# FLUVO ADMIN COMMAND PORTAL ENVIRONMENT VARIABLES
# Set these in your Vercel Project Settings (admin.fluvo.in)
# =============================================================================

# Supabase server-only credentials. Never use a public/publishable key for these APIs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Master Admin Authentication
ADMIN_EMAIL=connect@fluvo.in
ADMIN_PASSWORD_HASH=

# JWT Secret for signing HttpOnly session cookies (Generate with: openssl rand -base64 48)
JWT_SECRET=

# Domain URLs
PUBLIC_SITE_URL=https://www.fluvo.in
ADMIN_SITE_URL=https://admin.fluvo.in

# Outbound email automation (server-side only; configure in Vercel project settings)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=connect@fluvo.in
SMTP_PASSWORD=your_titan_password_here
EMAIL_FROM_NAME=Fluvo
EMAIL_FROM_ADDRESS=connect@fluvo.in
EMAIL_TEST_MODE=true
TEST_EMAIL_RECIPIENT=
EMAIL_WORKER_SECRET=
CRON_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_RATE_LIMIT_PER_HOUR=10
EMAIL_RATE_LIMIT_PER_DAY=50
EMAIL_DELAY_SECONDS=60

# Mailbox identity and IMAP synchronization (server-side only)
MAILBOX_EMAIL=connect@fluvo.in
EMAIL_ADDRESS=connect@fluvo.in
EMAIL_IMAP_HOST=imap.secureserver.net
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=connect@fluvo.in
# Optional when the mailbox uses the same password as SMTP_PASSWORD
EMAIL_IMAP_PASSWORD=
