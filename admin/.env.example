# =============================================================================
# FLUVO ADMIN COMMAND PORTAL ENVIRONMENT VARIABLES
# Set these in your Vercel Project Settings (admin.fluvo.in)
# =============================================================================

# Supabase Server-Only Credentials (Database URL and Service Role Key)
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to client-side bundles!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-secret-key

# Master Admin Authentication
ADMIN_EMAIL=connect@fluvo.in
# Generate bcrypt hash using: npm run generate-hash "YourStrongPassword"
ADMIN_PASSWORD_HASH=$2a$12$eX4mpL3h4sh...

# JWT Secret for signing HttpOnly session cookies (Generate with: openssl rand -base64 48)
JWT_SECRET=fluvo_super_secret_jwt_signing_key_change_in_production_min_32_chars

# Domain URLs
PUBLIC_SITE_URL=https://fluvo.in
ADMIN_SITE_URL=https://admin.fluvo.in
